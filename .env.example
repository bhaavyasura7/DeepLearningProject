# Database
POSTGRES_USER=movierec_user
POSTGRES_PASSWORD=movierec_password
POSTGRES_DB=movierec_db
POSTGRES_PORT=5432
DATABASE_URL=postgresql://movierec_user:movierec_password@localhost:5432/movierec_db
# For lightweight local execution without Docker:
# DATABASE_URL=sqlite:///./movierec.db

# Redis / Background Queue
REDIS_URL=redis://localhost:6379/0
REDIS_PORT=6379

# Security
SECRET_KEY=dev_secret_key_change_in_production_1234567890
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# LLM Provider Configuration
LLM_PROVIDER=mock # Options: mock, openai, ollama
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OLLAMA_BASE_URL=http://localhost:11434

# Recommendation Tuning
DECAY_RATE=0.05
SHORT_TERM_WEIGHT=0.6
LONG_TERM_WEIGHT=0.4
REC_BATCH_SIZE=10
COOLDOWN_MINUTES=60
